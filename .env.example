# ---------------------------------------------------------------
# Copy to .env  ->  cp .env.example .env
# Everything below is OPTIONAL. With no keys at all the whole stack
# still runs: OTPs print to the backend log, weather comes from the
# keyless Open-Meteo API, and the assistant answers from the local
# RAG corpus.
# ---------------------------------------------------------------

# --- ports ---
HTTP_PORT=8080
HTTPS_PORT=8443
PROMETHEUS_PORT=9091
GRAFANA_PORT=3005

# --- environment ---
ENV=development
DEV_MODE=true                 # true -> the OTP is returned in the API response for demos
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=*

# --- database ---
POSTGRES_USER=agri
POSTGRES_PASSWORD=agri
POSTGRES_DB=agrisense

# --- AI ---
GEMINI_API_KEY=              # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
WHISPER_MODEL=tiny           # tiny | base | small

# --- live government data (mandi prices) ---
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
SCHEME_REFRESH_ENABLED=true

# --- weather ---
WEATHER_PROVIDER=open-meteo  # open-meteo (no key) | weatherapi | openweather
WEATHERAPI_KEY=
OPENWEATHER_KEY=

# --- SMS for OTP ---
SMS_PROVIDER=console         # console | msg91 | twilio
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- monitoring ---
GRAFANA_PASSWORD=admin
