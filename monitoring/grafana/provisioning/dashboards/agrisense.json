{
  "title": "AgriSense API",
  "uid": "agrisense-api",
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries", "title": "Requests per second by endpoint",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (handler) (rate(http_requests_total[5m]))", "legendFormat": "{{handler}}"}]
    },
    {
      "type": "timeseries", "title": "p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{handler}}"}]
    },
    {
      "type": "stat", "title": "5xx rate",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "targets": [{"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))"}]
    },
    {
      "type": "stat", "title": "OTP verifications (5m)",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "targets": [{"expr": "sum(increase(http_requests_total{handler=\"/api/v1/auth/verify-otp\"}[5m]))"}]
    },
    {
      "type": "stat", "title": "Disease scans (1h)",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "sum(increase(http_requests_total{handler=\"/api/v1/disease/analyze\"}[1h]))"}]
    }
  ]
}
